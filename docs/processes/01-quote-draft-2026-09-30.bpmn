<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Quote" targetNamespace="https://engineer-cabinet/processes"><bpmn:process id="Process_Quote" name="Quote" isExecutable="false"><bpmn:startEvent id="qstart" name="Поступило задание"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:task id="qmanager" name="Я: выбрать менеджера"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:task><bpmn:task id="qrecord" name="Программа: дата, свободный номер менеджера, запись «Создан»"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:task id="qfolder" name="Программа: создать папку, Задание / Чертежи"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:task><bpmn:exclusiveGateway id="qok" name="Папка готова?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="qretry" name="Ошибка папки. Я: исправить причину, нажать «Повторить»"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task><bpmn:task id="qfiles" name="Я: добавить исходные файлы и комментарий"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task><bpmn:task id="qwork" name="Я: начать / возобновить, поставить «В работе»"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:task><bpmn:exclusiveGateway id="qdata" name="Хватает данных?"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="qpause" name="Я: «Пауза», получить недостающие данные"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task><bpmn:task id="qcad" name="Я: выполнить просчёт в AutoCAD, сохранить чертежи"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task><bpmn:task id="qready" name="Я: поставить «Готово»"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="qagain" name="Есть доработка?"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="qend" name="Готов; файлы сохранены"><bpmn:incoming>Flow_14</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0" sourceRef="qstart" targetRef="qmanager"/><bpmn:sequenceFlow id="Flow_1" sourceRef="qmanager" targetRef="qrecord"/><bpmn:sequenceFlow id="Flow_2" sourceRef="qrecord" targetRef="qfolder"/><bpmn:sequenceFlow id="Flow_3" sourceRef="qfolder" targetRef="qok"/><bpmn:sequenceFlow id="Flow_4" sourceRef="qok" targetRef="qfiles" name="Да"/><bpmn:sequenceFlow id="Flow_5" sourceRef="qok" targetRef="qretry" name="Нет"/><bpmn:sequenceFlow id="Flow_6" sourceRef="qretry" targetRef="qfolder" name="Повтор"/><bpmn:sequenceFlow id="Flow_7" sourceRef="qfiles" targetRef="qwork"/><bpmn:sequenceFlow id="Flow_8" sourceRef="qwork" targetRef="qdata"/><bpmn:sequenceFlow id="Flow_9" sourceRef="qdata" targetRef="qcad" name="Да"/><bpmn:sequenceFlow id="Flow_10" sourceRef="qdata" targetRef="qpause" name="Нет"/><bpmn:sequenceFlow id="Flow_11" sourceRef="qpause" targetRef="qwork" name="Данные получены"/><bpmn:sequenceFlow id="Flow_12" sourceRef="qcad" targetRef="qready"/><bpmn:sequenceFlow id="Flow_13" sourceRef="qready" targetRef="qagain"/><bpmn:sequenceFlow id="Flow_14" sourceRef="qagain" targetRef="qend" name="Нет"/><bpmn:sequenceFlow id="Flow_15" sourceRef="qagain" targetRef="qwork" name="Да"/><bpmn:textAnnotation id="Note_0"><bpmn:text>Черновик 30.09.2026 23:14. Редактор схем, не серверное исполнение.
Номер: отдельный счётчик менеджера, без календарного сброса. Освободившиеся номера повторно используются. При нескольких свободных — обсудить порядок.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Note_1"><bpmn:text>D:\Просчеты\&lt;Менеджер&gt;\№0001_30.09.26\
Подпапки: Задание, Чертежи.
Несколько просчётов в день: разные номера, одинаковая дата.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Note_2"><bpmn:text>Комментарий в строке и карточке — одно поле. Сумм и сроков нет.
Связь с заявкой: галочка + номер. Отбор без заявок и количество. Один к одному, связь изменяема.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Note_3"><bpmn:text>Удаление с подтверждением: запись и собственная папка с содержимым. Для связанного просчёта — предупреждение, связь очищается, заявка сохраняется.
«Готово» можно позднее вернуть в работу.</bpmn:text></bpmn:textAnnotation></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Quote"><bpmndi:BPMNPlane id="Plane_Quote" bpmnElement="Process_Quote"><bpmndi:BPMNShape id="Shape_qstart" bpmnElement="qstart"><dc:Bounds x="312" y="30" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qmanager" bpmnElement="qmanager"><dc:Bounds x="200" y="110" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qrecord" bpmnElement="qrecord"><dc:Bounds x="200" y="240" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qfolder" bpmnElement="qfolder"><dc:Bounds x="200" y="370" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qok" bpmnElement="qok"><dc:Bounds x="305" y="510" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qretry" bpmnElement="qretry"><dc:Bounds x="650" y="490" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qfiles" bpmnElement="qfiles"><dc:Bounds x="200" y="640" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qwork" bpmnElement="qwork"><dc:Bounds x="200" y="770" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qdata" bpmnElement="qdata"><dc:Bounds x="305" y="910" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qpause" bpmnElement="qpause"><dc:Bounds x="650" y="890" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qcad" bpmnElement="qcad"><dc:Bounds x="200" y="1040" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qready" bpmnElement="qready"><dc:Bounds x="200" y="1170" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qagain" bpmnElement="qagain"><dc:Bounds x="305" y="1310" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_qend" bpmnElement="qend"><dc:Bounds x="312" y="1450" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Edge_0" 