<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Order" targetNamespace="https://engineer-cabinet/processes"><bpmn:process id="Process_Order" name="Order" isExecutable="false"><bpmn:startEvent id="ostart" name="Поступила заявка"><bpmn:outgoing>Flow_0</bpmn:outgoing></bpmn:startEvent><bpmn:task id="onum" name="Я: ввести номер (123 → №00123)"><bpmn:incoming>Flow_0</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing><bpmn:incoming>Flow_3</bpmn:incoming></bpmn:task><bpmn:exclusiveGateway id="odup" name="Номер занят?"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="owarn" name="Программа: оповестить, запретить дубликат"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="olink" name="Добавить просчёт?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="oselect" name="Я: выбрать свободный просчёт; программа подставляет менеджера"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task><bpmn:task id="oman" name="Я: выбрать / поправить менеджера"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task><bpmn:task id="osave" name="Программа: запись «Создан», сумма пустая"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:task><bpmn:task id="ofolder" name="Создать / привязать папку; добавить недостающие подпапки"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:task><bpmn:exclusiveGateway id="ook" name="Папка готова?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="oretry" name="Ошибка. Я: исправить причину и нажать «Повторить»"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task><bpmn:task id="owork" name="Я: файлы, комментарий, работа и личный статус"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task><bpmn:task id="omonth" name="Я: выбрать месяц закрытия из любого рабочего статуса"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="osum" name="Сумма заполнена?"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="oenter" name="Запросить сумму. Я: ввести сумму; 0 допустим"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:task><bpmn:task id="ocalc" name="Округлить сумму до рубля; рассчитать и округлить 3%"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:task><bpmn:task id="oclose" name="Программа: текущий год, месяц, «Завершённая»"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:task><bpmn:task id="oreport" name="Программа: включить заявку и заработок в месячный отчёт"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:task><bpmn:endEvent id="oend" name="Заявка завершена"><bpmn:incoming>Flow_21</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_0" sourceRef="ostart" targetRef="onum"/><bpmn:sequenceFlow id="Flow_1" sourceRef="onum" targetRef="odup"/><bpmn:sequenceFlow id="Flow_2" sourceRef="odup" targetRef="owarn" name="Да"/><bpmn:sequenceFlow id="Flow_3" sourceRef="owarn" targetRef="onum" name="Исправить номер"/><bpmn:sequenceFlow id="Flow_4" sourceRef="odup" targetRef="olink" name="Нет"/><bpmn:sequenceFlow id="Flow_5" sourceRef="olink" targetRef="oman" name="Нет"/><bpmn:sequenceFlow id="Flow_6" sourceRef="olink" targetRef="oselect" name="Да"/><bpmn:sequenceFlow id="Flow_7" sourceRef="oselect" targetRef="oman"/><bpmn:sequenceFlow id="Flow_8" sourceRef="oman" targetRef="osave"/><bpmn:sequenceFlow id="Flow_9" sourceRef="osave" targetRef="ofolder"/><bpmn:sequenceFlow id="Flow_10" sourceRef="ofolder" targetRef="ook"/><bpmn:sequenceFlow id="Flow_11" sourceRef="ook" targetRef="owork" name="Да"/><bpmn:sequenceFlow id="Flow_12" sourceRef="ook" targetRef="oretry" name="Нет"/><bpmn:sequenceFlow id="Flow_13" sourceRef="oretry" targetRef="ofolder" name="Повтор"/><bpmn:sequenceFlow id="Flow_14" sourceRef="owork" targetRef="omonth"/><bpmn:sequenceFlow id="Flow_15" sourceRef="omonth" targetRef="osum"/><bpmn:sequenceFlow id="Flow_16" sourceRef="osum" targetRef="oenter" name="Нет"/><bpmn:sequenceFlow id="Flow_17" sourceRef="oenter" targetRef="osum" name="Проверить"/><bpmn:sequenceFlow id="Flow_18" sourceRef="osum" targetRef="ocalc" name="Да, в том числе 0"/><bpmn:sequenceFlow id="Flow_19" sourceRef="ocalc" targetRef="oclose"/><bpmn:sequenceFlow id="Flow_20" sourceRef="oclose" targetRef="oreport"/><bpmn:sequenceFlow id="Flow_21" sourceRef="oreport" targetRef="oend"/><bpmn:textAnnotation id="Note_0"><bpmn:text>Черновик 30.09.2026 23:14. При занятом номере — никакой новой записи/папки. Номер редактируется с подтверждением, проверкой дубля и переименованием папки.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Note_1"><bpmn:text>Связь 1:1 необязательна. Только ссылка на папку просчёта, без копирования. Можно добавить/заменить/снять в любой момент. Менеджер просчёта неизменен; в заявке редактируется вручную.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Note_2"><bpmn:text>D:\Заявки\№00123\
Задание / Чертежи / Фото / На отправку.
Существующие файлы при привязке не затираются. Для перемещённой папки — «Указать папку».</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Note_3"><bpmn:text>Рабочие статусы: Создан → В работе → Готово; Готово → В работе допустим.
В работе → Пауза → В работе: только нехватка исходных данных.
Закрытие разрешено из любого рабочего статуса.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Note_4"><bpmn:text>Сумма заполняется позже, меняется в любой момент. Пусто ≠ 0. При любой правке: округлить сумму до рубля, затем 3% до рубля; 50 копеек вверх. Сроков нет. Комментарий в строке = карточка.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Note_5"><bpmn:text>После закрытия: нельзя вернуть в работу или удалить. Сумму можно менять с пересчётом; месяц можно исправить с переносом заработка. Сохранённый год не меняется.
Отчёт: заявки, суммы, 3%, месячный итог.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Note_6"><bpmn:text>Незавершённую заявку можно удалить с подтверждением вместе с её собственной папкой. Просчёт и его папка сохраняются.
Обсудить: файловые ошибки удаления/переименования и очистку суммы после закрытия.</bpmn:text></bpmn:textAnnotation></bpmn:process><bpmndi:BPMNDiagram id="Diagram_Order"><bpmndi:BPMNPlane id="Plane_Order" bpmnElement="Process_Order"><bpmndi:BPMNShape id="Shape_ostart" bpmnElement="ostart"><dc:Bounds x="312" y="30" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_onum" bpmnElement="onum"><dc:Bounds x="200" y="110" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_odup" bpmnElement="odup"><dc:Bounds x="305" y="250" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_owarn" bpmnElement="owarn"><dc:Bounds x="650" y="230" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_olink" bpmnElement="olink"><dc:Bounds x="305" y="380" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_oselect" bpmnElement="oselect"><dc:Bounds x="650" y="390" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_oman" bpmnElement="oman"><dc:Bounds x="200" y="530" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_osave" bpmnElement="osave"><dc:Bounds x="200" y="660" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_ofolder" bpmnElement="ofolder"><dc:Bounds x="200" y="790" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_ook" bpmnElement="ook"><dc:Bounds x="305" y="930" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_oretry" bpmnElement="oretry"><dc:Bounds x="650" y="910" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_owork" bpmnElement="owork"><dc:Bounds x="200" y="1060" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_omonth" bpmnElement="omonth"><dc:Bounds x="200" y="1190" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_osum" bpmnElement="osum"><dc:Bounds x="305" y="1330" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_oenter" bpmnElement="oenter"><dc:Bounds x="650" y="1310" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_ocalc" bpmnElement="ocalc"><dc:Bounds x="200" y="1460" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_oclose" bpmnElement="oclose"><dc:Bounds x="200" y="1590" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_oreport" bpmnElement="oreport"><dc:Bounds x="200" y="1720" width="260" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Shape_oend" bpmnElement="oend"><dc:Bounds x="312" y="1870" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Edge_0" bpmnElement="Flow_0"><di:waypoint x="330" y="66"/><di:waypoint x="330" y="110"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1"><di:waypoint x="330" y="190"/><di:waypoint x="330" y="250"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2"><di:waypoint x="355" y="275"/><di:waypoint x="650" y="275"/><bpmndi:BPMNLabel><dc:Bounds x="365" y="283" width="135" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3"><di:waypoint x="780" y="230"/><di:waypoint x="780" y="150"/><di:waypoint x="460" y="150"/><bpmndi:BPMNLabel><dc:Bounds x="790" y="238" width="135" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4"><di:waypoint x="330" y="300"/><di:waypoint x="330" y="380"/><bpmndi:BPMNLabel><dc:Bounds x="340" y="308" width="135" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5"><di:waypoint x="330" y="430"/><di:waypoint x="330" y="530"/><bpmndi:BPMNLabel><dc:Bounds x="340" y="438" width="135" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6"><di:waypoint x="355" y="405"/><di:waypoint x="650" y="405"/><bpmndi:BPMNLabel><dc:Bounds x="365" y="413" width="135" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMN